name: Deploy

# Only changes that can alter what runs on the box trigger a deploy: the
# workspace crates, the area blueprints shipped alongside the binary, the
# include_str!-baked assets, the deploy script/unit, and the manifests that
# pin the build. Everything else (docs, .planning/, CI, scripts) skips the
# pipeline; `Run workflow` forces a deploy when needed.
on:
  push:
    branches: [main]
    paths:
      - 'crates/**'
      - 'data/areas/**'
      - 'assets/**'
      - 'deploy/**'
      - 'Cargo.toml'
      - 'Cargo.lock'
      - 'rust-toolchain.toml'
  workflow_dispatch: {}

# Never let two deploys race onto the same host.
concurrency:
  group: deploy-production
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: x86_64-unknown-linux-musl

      # rust-toolchain.toml pins 1.98.1, which makes the action ignore the
      # `targets:` input above (observed: musl target missing, E0463 on
      # `core`/`std`). Install against the active toolchain explicitly.
      - name: Add musl target
        run: rustup target add x86_64-unknown-linux-musl

      # Matches ci.yml. Keyed separately so the musl target dir doesn't collide
      # with CI's host-target cache.
      - uses: Swatinem/rust-cache@v2
        with:
          key: musl-release

      # Static musl build: one binary that runs on any x86_64 Linux AMI with no
      # glibc-version matching. t2.micro never compiles anything — CI does.
      - name: Install musl tools
        run: sudo apt-get update && sudo apt-get install -y musl-tools

      - name: Build release binary
        run: cargo build --release --target x86_64-unknown-linux-musl -p example-mud

      - name: Stage artifact
        run: |
          mkdir -p dist
          cp target/x86_64-unknown-linux-musl/release/example-mud dist/grim

      - uses: actions/upload-artifact@v4
        with:
          name: grim-binary
          path: dist/grim
          retention-days: 7

  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/download-artifact@v4
        with:
          name: grim-binary
          path: dist

      - name: Configure SSH
        run: |
          mkdir -p ~/.ssh
          printf '%s\n' "${{ secrets.EC2_SSH_KEY }}" > ~/.ssh/id_deploy
          chmod 600 ~/.ssh/id_deploy
          ssh-keyscan -H "${{ secrets.EC2_HOST }}" >> ~/.ssh/known_hosts 2>/dev/null

      - name: Upload binary and deploy script
        env:
          TARGET: ${{ secrets.EC2_USER }}@${{ secrets.EC2_HOST }}
        run: |
          scp -i ~/.ssh/id_deploy dist/grim "$TARGET:/opt/grim/bin/grim.new"
          scp -i ~/.ssh/id_deploy deploy/deploy.sh "$TARGET:/opt/grim/bin/"
          scp -i ~/.ssh/id_deploy deploy/grim.service "$TARGET:/opt/grim/bin/"
          # Committed world content (area blueprints), read from disk at runtime.
          # Staged next to the binary; deploy.sh syncs it into data/areas.
          ssh -i ~/.ssh/id_deploy "$TARGET" 'rm -rf /opt/grim/bin/areas.staged'
          scp -i ~/.ssh/id_deploy -r data/areas "$TARGET:/opt/grim/bin/areas.staged"
          # Committed social overrides, read from disk at startup.
          # Staged next to the binary; deploy.sh syncs it into data/socials.
          ssh -i ~/.ssh/id_deploy "$TARGET" 'rm -rf /opt/grim/bin/socials.staged'
          scp -i ~/.ssh/id_deploy -r data/socials "$TARGET:/opt/grim/bin/socials.staged"

      - name: Run deploy
        env:
          TARGET: ${{ secrets.EC2_USER }}@${{ secrets.EC2_HOST }}
        run: |
          ssh -i ~/.ssh/id_deploy "$TARGET" \
            "chmod +x /opt/grim/bin/deploy.sh && /opt/grim/bin/deploy.sh"
