[Unit]
Description=GRIM MUD server
After=network.target

[Service]
# notify: the server sends READY=1 once its listener is up. This is also what
# makes copyover work — the predecessor + successor send MAINPID so systemd
# follows the handoff instead of treating the predecessor's exit as a crash.
# WITHOUT Type=notify (e.g. a stale Type=simple unit) a copyover looks like the
# main process dying, and systemd stops the service (SIGTERM → the in-game 30s
# countdown). deploy.sh keeps this file in sync so the box can't drift back.
Type=notify
NotifyAccess=all
# `User=` is rendered by deploy.sh to the deploy/SSH user (so signalling the
# process needs no privilege); the value here is a placeholder.
User=grim
WorkingDirectory=/opt/grim
Environment=GRIM_BIND_HOST=0.0.0.0
ExecStart=/opt/grim/bin/grim
# Lets `systemctl reload grim` trigger a copyover too (deploy.sh uses a direct
# SIGUSR2 to avoid needing privileged systemctl, but this keeps the idiom available).
ExecReload=/bin/kill -USR2 $MAINPID
# Clean exit (code 0, from an admin `shutdown` or the SIGTERM countdown) stays
# down so a cold deploy can swap the binary. Only a crash (non-zero) restarts.
Restart=on-failure
RestartSec=2
# SIGTERM triggers the in-server graceful countdown (players are warned) rather
# than an abrupt kill. TimeoutStopSec must exceed that countdown (30s) or systemd
# SIGKILLs mid-countdown.
KillSignal=SIGTERM
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
