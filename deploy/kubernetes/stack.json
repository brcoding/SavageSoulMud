    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "savsoul-runtime",
        "namespace": "savsoul"
      },
      "data": {
        "nginx.conf": "worker_processes 1;\npid /tmp/nginx.pid;\nerror_log /dev/stderr warn;\nevents { worker_connections 1024; }\n\nstream {\n    set_real_ip_from 192.168.255.0/24;\n    set_real_ip_from 127.0.0.1;\n    proxy_connect_timeout 5s;\n    proxy_timeout 24h;\n    # NodeBalancer TCP checks carry its private address, not a player address.\n    geo $proxy_protocol_addr $balancer_health_check {\n        default 0;\n        192.168.255.0/24 1;\n    }\n    map $balancer_health_check $mud_backend {\n        default 127.0.0.1:4003;\n        1 127.0.0.1:9081;\n    }\n    server {\n        listen 127.0.0.1:9081;\n        return '';\n    }\n    server {\n        listen 14000 proxy_protocol;\n        proxy_pass $mud_backend;\n        proxy_protocol on;\n    }\n    server {\n        listen 14001 ssl proxy_protocol;\n        ssl_certificate /run/savsoul-tls/server.crt;\n        ssl_certificate_key /run/savsoul-tls/server.key;\n        ssl_protocols TLSv1.2 TLSv1.3;\n        proxy_pass $mud_backend;\n        proxy_protocol on;\n    }\n}\n\nhttp {\n    include /etc/nginx/mime.types;\n    default_type application/octet-stream;\n    access_log off;\n    server_tokens off;\n    client_max_body_size 32m;\n    client_body_temp_path /tmp/client;\n    proxy_temp_path /tmp/proxy;\n    fastcgi_temp_path /tmp/fastcgi;\n    uwsgi_temp_path /tmp/uwsgi;\n    scgi_temp_path /tmp/scgi;\n    set_real_ip_from 192.168.255.0/24;\n    set_real_ip_from 127.0.0.1;\n    real_ip_header proxy_protocol;\n    map $http_upgrade $connection_upgrade { default upgrade; '' close; }\n\n    server {\n        listen 9080;\n        location = /healthz { access_log off; return 200 'ready\\n'; }\n        location / { return 404; }\n    }\n    server {\n        listen 8080 proxy_protocol default_server;\n        root /var/www/lpmud;\n        index index.html;\n        location ~ /\\. { deny all; }\n        location / { try_files $uri $uri/ =404; }\n    }\n    server {\n        listen 8080 proxy_protocol;\n        server_name savsoul.com www.savsoul.com;\n        return 301 https://$host$request_uri;\n    }\n    server {\n        listen 8443 ssl proxy_protocol;\n        server_name savsoul.com www.savsoul.com;\n        ssl_certificate /run/savsoul-tls/server.crt;\n        ssl_certificate_key /run/savsoul-tls/server.key;\n        ssl_protocols TLSv1.2 TLSv1.3;\n        root /var/www/lpmud;\n        index index.html;\n        add_header X-Content-Type-Options nosniff always;\n        add_header Referrer-Policy same-origin always;\n        location ~ /\\. { deny all; }\n        location = /playnow.html {\n            add_header Content-Security-Policy \"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' wss://savsoul.com wss://www.savsoul.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'\";\n            add_header Cache-Control no-cache;\n        }\n        location = /mud-websocket {\n            proxy_pass http://127.0.0.1:4086;\n            proxy_http_version 1.1;\n            proxy_set_header Host $http_host;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection $connection_upgrade;\n            proxy_set_header X-Forwarded-For $remote_addr;\n            proxy_set_header X-Savsoul-Client-IP '';\n            proxy_read_timeout 24h;\n        }\n        location / { try_files $uri $uri/ =404; }\n    }\n    server {\n        listen 14080 proxy_protocol;\n        return 301 https://$host:4081$request_uri;\n    }\n    server {\n        listen 14481 ssl proxy_protocol;\n        server_name savsoul.com www.savsoul.com;\n        ssl_certificate /run/savsoul-tls/server.crt;\n        ssl_certificate_key /run/savsoul-tls/server.key;\n        ssl_protocols TLSv1.2 TLSv1.3;\n        location / {\n            proxy_pass http://127.0.0.1:4085;\n            proxy_set_header Host $http_host;\n            proxy_set_header X-Forwarded-For $remote_addr;\n            proxy_set_header X-Forwarded-Proto https;\n            proxy_read_timeout 90s;\n        }\n    }\n}\n",
        "services.json": "{\n  \"grim\": {\n    \"cwd\": \"/home/savsoul/grim\",\n    \"command\": [\n      \"/usr/local/bin/python3\",\n      \"/home/savsoul/grim/tools/server-host/notify_runner.py\",\n      \"--state\",\n      \"/home/savsoul/state/runner\",\n      \"--\",\n      \"/home/savsoul/grim/bin/savsoul\"\n    ],\n    \"env\": {\n      \"GRIM_BIND_HOST\": \"0.0.0.0\"\n    }\n  },\n  \"editor\": {\n    \"cwd\": \"/home/savsoul/grim\",\n    \"command\": [\n      \"/home/savsoul/runtime/venv/bin/python\",\n      \"tools/server-host/remote_editor.py\"\n    ],\n    \"env\": {\n      \"GRIM_BIND_HOST\": \"0.0.0.0\"\n    }\n  },\n  \"intermud\": {\n    \"cwd\": \"/home/savsoul/runtime/i3-gateway\",\n    \"command\": [\n      \"/home/savsoul/runtime/venv/bin/python\",\n      \"-m\",\n      \"src\",\n      \"--config\",\n      \"/home/savsoul/grim/tools/intermud/gateway.yaml\",\n      \"--env-file\",\n      \"/home/savsoul/.local/state/savsoul-intermud/gateway.env\"\n    ],\n    \"env\": {\n      \"GRIM_BIND_HOST\": \"0.0.0.0\"\n    }\n  },\n  \"web-terminal\": {\n    \"cwd\": \"/home/savsoul/grim\",\n    \"command\": [\n      \"/home/savsoul/runtime/venv/bin/python\",\n      \"/home/savsoul/grim/tools/web-terminal/bridge.py\"\n    ],\n    \"env\": {\n      \"GRIM_BIND_HOST\": \"0.0.0.0\"\n    }\n  },\n  \"trainer\": {\n    \"cwd\": \"/home/savsoul/runtime/trainer\",\n    \"command\": [\n      \"/home/savsoul/runtime/trainer/llama-server\",\n      \"--model\",\n      \"/home/savsoul/runtime/trainer/model.gguf\",\n      \"--host\",\n      \"127.0.0.1\",\n      \"--port\",\n      \"4091\",\n      \"--ctx-size\",\n      \"1024\",\n      \"--threads\",\n      \"1\",\n      \"--threads-batch\",\n      \"1\",\n      \"--parallel\",\n      \"1\",\n      \"--jinja\",\n      \"--reasoning-budget\",\n      \"0\",\n      \"--no-webui\",\n      \"--log-disable\"\n    ],\n    \"env\": {\n      \"GRIM_BIND_HOST\": \"0.0.0.0\"\n    }\n  }\n}\n",
        "launch.py": "\"\"\"Foreground container launcher; activation is a separate coordinated cutover.\"\"\"\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport time\n\nHOME = Path('/home/savsoul')\nSTATE = HOME / 'state/kubernetes'\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('service', choices=('grim', 'editor', 'web-terminal', 'intermud', 'trainer'))\n    args = parser.parse_args()\n    if not (STATE / 'bootstrap-complete').is_file():\n        raise RuntimeError('Candidate runtime has not been prepared')\n    if args.service == 'intermud' and not (STATE / 'networks-active').exists():\n        print('Intermud waits for coordinated cutover; no gateway process is running.', flush=True)\n        while not (STATE / 'networks-active').exists():\n            time.sleep(2)\n    if args.service == 'grim' and not (STATE / 'networks-active').exists():\n        for name in ('intermud', 'grapevine', 'zebedee'):\n            path = HOME / ('grim/data/' + name + '.json')\n            if path.exists() and json.loads(path.read_text()).get('enabled'):\n                raise RuntimeError('Candidate external network adapter must remain disabled')\n    if args.service == 'trainer' and 'avx2' not in Path('/proc/cpuinfo').read_text():\n        raise RuntimeError('Retained trainer binary requires an AVX2-capable node')\n    services = json.loads(Path('/etc/savsoul/services.json').read_text())\n    service = services[args.service]\n    os.chdir(service['cwd'])\n    os.environ.update(service.get('env', {}))\n    os.environ.update({'HOME': str(HOME), 'PYTHONDONTWRITEBYTECODE': '1',\n                      'SSL_CERT_FILE': '/etc/ssl/certs/ca-certificates.crt',\n                      'REQUESTS_CA_BUNDLE': '/etc/ssl/certs/ca-certificates.crt'})\n    if args.service == 'grim':\n        os.environ['GRIM_PROXY_PORT'] = '4003'\n    command = service['command']\n    os.execv(command[0], command)\n\n\nif __name__ == '__main__':\n    main()\n"
      }
    },
